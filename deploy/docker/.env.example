# Copy this file to .env (same folder) and adjust as needed.
# .env is gitignored - it's read automatically by `docker compose` here.

# PostgreSQL (product-service, order-service).
# Must match the postgres service's own POSTGRES_USER/POSTGRES_PASSWORD
# below in docker-compose.yml, not an independent choice - order/product
# use these to log in to that same container.
DB_USER=embarkx
DB_PASSWORD=embarkx

# MongoDB (user-service). The mongo container runs with no auth configured
# in docker-compose.yml, so no username/password is needed here.
MONGO_URI=mongodb://mongo:27017/ecom_user

# RabbitMQ (Spring Cloud Bus config-refresh broadcasts - NOT the
# order-created event, that goes over Kafka, whose broker address is
# hardcoded to kafka:9092 in order/notification's own config rather than
# coming from an env var here).
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Zipkin (distributed tracing)
ZIPKIN_URL=http://zipkin:9411/api/v2/spans

# pgAdmin - optional, these already have sane defaults if left unset
PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=admin
