# Copy this file to `.env` (same folder) before running `docker compose up`.
# `.env` is gitignored - never commit real credentials.

# PostgreSQL: used to create the postgres container AND by the product/order services.
# Pick any values; they are fixed the first time the postgres volume is created
# (to change them later: `docker compose down -v`, which wipes DB data).
DB_USER=ecom_admin
DB_PASSWORD=change_me

# MongoDB (user-service). `mongo` is the container name from docker-compose.yml.
MONGO_URI=mongodb://mongo:27017/ecom_user

# RabbitMQ (config server + Spring Cloud Bus)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Zipkin tracing
ZIPKIN_URL=http://zipkin:9411/api/v2/spans

# Config server symmetric key for /encrypt and /decrypt (and {cipher} values in config).
# Any long random string; keep it secret outside local dev.
ENCRYPT_KEY=change-me-to-a-long-random-string

# Optional (fall back to defaults if unset)
# PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
# PGADMIN_DEFAULT_PASSWORD=admin
